PORT=5000
HOST="0.0.0.0"
CORS_ORIGIN="http://localhost:8080"
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# Contact message admin page (/admin/contact) and /api/admin/*.
# Long random string, at least 32 characters. Leave empty to disable the admin page.
ADMIN_TOKEN=
# Optional: email each new contact message to this address (needs the SMTP_* settings).
CONTACT_NOTIFY_TO=
